#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
NKImage — Bibliothèque de chargement/sauvegarde d'images (C++17)
================================================================
Bibliothèque self-contained sans dépendance externe.
Formats supportés :
  Lecture  : PNG, JPEG, BMP, TGA, HDR, PPM/PGM/PBM, QOI, GIF, ICO, WebP, SVG
  Écriture : PNG, JPEG, BMP, TGA, HDR, PPM, QOI, GIF, WebP, SVG

Pipeline SVG complet :
  1. NkXMLParser    — tokenizer XML + DOM
  2. NkSVGDOM       — arbre SVG avec CSS cascade, gradients, clipPath
  3. NkSVGRenderer  — rasterisation RGBA32
"""

from Jenga import *
from jengaconfig import *

with project("NKImage"):
    language("C++")
    cppdialect("C++17")
    location(".")

    nkentseudependson(
        ["NKPlatform", "NKCore", "NKMemory", "NKMath", "NKContainers", "NKLogger", "NKThreading", "NKFileSystem", "NKStream"],
        selfexport="NKImage",
        extra_includes=["src"],
    )

    files([
        # Core
        "src/NKImage/Core/NkImage.cpp",
        "src/NKImage/Core/NkXMLParser.cpp",
        # Codecs image natifs
        "src/NKImage/Codecs/PNG/NkPNGCodec.cpp",
        "src/NKImage/Codecs/JPEG/NkJPEGCodec.cpp",
        "src/NKImage/Codecs/BMP/NkBMPCodec.cpp",
        "src/NKImage/Codecs/TGA/NkTGACodec.cpp",
        "src/NKImage/Codecs/HDR/NkHDRCodec.cpp",
        "src/NKImage/Codecs/EXR/NkEXRCodec.cpp",
        "src/NKImage/Codecs/PPM/NkPPMCodec.cpp",
        "src/NKImage/Codecs/QOI/NkQOICodec.cpp",
        "src/NKImage/Codecs/GIF/NkGIFCodec.cpp",
        "src/NKImage/Codecs/ICO/NkICOCodec.cpp",
        "src/NKImage/Codecs/WEBP/NkWebPCodec.cpp",
        # SVG (reecrit from scratch 2026-05-19 inspire NanoSVG, mono-fichier)
        # NkSVGDOM.cpp + NkSVGRenderer.cpp retires (pipeline DOM inutilise).
        "src/NKImage/Codecs/SVG/NkSVGCodec.cpp",
        # Backend STB (alternatif pendant développement des codecs natifs)
        # "src/NKImage/Codecs/STB/NkSTBCodec.cpp",
        # Headers (pour IDEs)
        "src/NKImage/**.h",
    ])
    pchheader("pch/pch.h")
    pchsource("pch/pch.cpp")

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}")

    with filter("system:Windows && options:windows-runtime=uwp"):
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-uwp/%{prj.name}")
        targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}-uwp")

    # ===== Windows ================================================================
    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines([
            "WIN32_LEAN_AND_MEAN",
            "_UNICODE",
            "UNICODE",
        ])

    # ===== Linux ==================================================================
    with filter("system:Linux && options:linux-backend=headless || system:Linux && options:headless"):
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-headless/%{prj.name}")
        targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}-headless")

    with filter("system:Linux && options:linux-backend=xcb"):
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-xcb/%{prj.name}")
        targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}-xcb")

    with filter("system:Linux && options:linux-backend=wayland"):
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-wayland/%{prj.name}")
        targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}-wayland")

    # ===== macOS ==================================================================
    with filter("system:macOS"):
        usetoolchain("clang-native")

    # ===== Android ================================================================
    with filter("system:Android"):
        # Workaround: disable PCH on Android (NDK r27 + clang 18 + libc++)
        pchheader("")
        pchsource("")
        usetoolchain("android-ndk")
        links(["android", "log"])
        androidminsdk(21)
        androidtargetsdk(34)
        androidcompilesdk(34)
        androidabis(["armeabi-v7a", "arm64-v8a", "x86", "x86_64"])

    # ===== HarmonyOS ==============================================================
    with filter("system:HarmonyOS"):
        # PCH desactive (NDK OHOS clang, meme contrainte qu'Android).
        pchheader("")
        pchsource("")
        usetoolchain("ohos-ndk")
        links(["hilog_ndk.z"])

    # ===== iOS ====================================================================
    with filter("system:iOS"):
        iosminsdk("13.0")

    # ===== Web ====================================================================
    with filter("system:Web"):
        usetoolchain("emscripten")

    # ===== UWP ====================================================================
    with filter("system:UWP || system:Windows && options:windows-runtime=uwp"):
        usetoolchain("xbox-clang")
        defines(["NKENTSEU_PLATFORM_UWP"])
        links(["windowsapp"])

    # ===== Xbox ===================================================================
    with filter("system:XboxSeries || system:XboxOne"):
        usetoolchain("xbox-clang")
        defines(["NKENTSEU_PLATFORM_XBOX"])

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

    # Tests unitaires (desktop uniquement)
    with filter("(system:Linux || system:macOS || (system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne)) && !system:Android && !system:iOS && !system:Web"):
        with test():
            testfiles(["tests/**.cpp"])
            # ── FUSION DU 2026-09-12 : TRANCHE PAR L HISTOIRE, ET LA QUESTION EST ECRITE ICI ──
            # Deux reparations ALTERNATIVES du meme defaut (TestEXR.cpp a son propre main) :
            #   main    (860e9d7f1, PR #85, ecrit le 05/09) : excludefiles(TestEXR)  <- GARDE
            #   branche (9d3452b37, 04/09)                 : testownmain()          <- ci-dessous
            # Aucun message ne dit avoir remplace l autre ; la plus recente sur main l emporte.
            # ⚠️ MESURE, LES DEUX COTES, EN EXECUTION (jenga test --force, puis l exe lance a la main) :
            #   excludefiles : No source files found -> Tests : 0 reussis, 0 au total  (vide vert)
            #   testownmain  : 1 source, un exe, il tourne -> Tests : 0 reussis, 0 au total (vide vert)
            # TestEXR.cpp porte un main() Unitest qui n enregistre AUCUN cas. Aucun cote ne fait
            # tourner quoi que ce soit : NKImage_Tests est une suite VIDE qui se dit reussie.
            # QUESTION POUR RODOLF : que doit etre NKImage_Tests ? (a) vide jusqu a de vrais
            # essais unitaires -- c est l etat present ; (b) TestEXR promu en suite, ce qui
            # suppose d y ENREGISTRER des cas, sinon (b) = (a). Le mot de la branche, pour
            # rejouer (b) : testownmain()
            # TestEXR.cpp est un OUTIL autonome, pas un test unitaire : il definit
            # son propre main(), qui entrait en conflit avec celui que Jenga genere
            # pour Unitest. La suite NKImage_Tests ne se construisait donc plus du
            # tout, en silence. Exclu le 2026-09-05 ; le fichier reste dans le depot
            # comme code de validation du codec EXR.
            excludefiles(["tests/TestEXR.cpp"])
            links([
                "NKImage",
                "NKMemory",
                "NKCore",
            ])
